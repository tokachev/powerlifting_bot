# Telegram
TELEGRAM_TOKEN=xxx:yyy
# Comma/space separated Telegram IDs allowed to use the bot and dashboard data.
# Required in production; set this to your own Telegram numeric ID.
PWRBOT_ALLOWED_TELEGRAM_IDS=123456789

# Dashboard/API Basic Auth. Required for `python -m pwrbot.api` and dashboard Docker service.
PWRBOT_DASHBOARD_USERNAME=admin
PWRBOT_DASHBOARD_PASSWORD=change-me

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_S=60

# Analysis backends
GEMMA_ANALYSIS_ENABLED=true
CODEX_ENABLED=false
CODEX_WS_URL=ws://host.docker.internal:4500
CODEX_TOKEN_FILE=/run/secrets/codex-app-server-token
# Optional: override config/settings.yaml llm.codex.model for a specific local app-server/account.
CODEX_MODEL=

# Storage
DB_PATH=./data/pwrbot.db
CONFIG_PATH=./config/settings.yaml
EXERCISES_PATH=./config/exercises.yaml
PROMPTS_DIR=./prompts

# Logging
LOG_LEVEL=INFO
