# Telegram
TELEGRAM_TOKEN=xxx:yyy

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_S=60

# Analysis backends
GEMMA_ANALYSIS_ENABLED=true
CODEX_ENABLED=false
CODEX_WS_URL=ws://host.docker.internal:4500
CODEX_TOKEN_FILE=/run/secrets/codex-app-server-token

# Storage
DB_PATH=./data/pwrbot.db
CONFIG_PATH=./config/settings.yaml
EXERCISES_PATH=./config/exercises.yaml
PROMPTS_DIR=./prompts

# Logging
LOG_LEVEL=INFO
